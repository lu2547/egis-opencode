# ── 服务 ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=38083
LOG_LEVEL=INFO

# ── LLM（企业网关 / openai 兼容端点）─────────────────
LLM_PROVIDER=openai
MODEL_NAME=gpt-4o
API_KEY=sk-xxx
# LLM_BASE_URL=https://your-gateway.example.com/v1

# 单次 LLM 输出 token 上限（对齐 opencode OUTPUT_TOKEN_MAX=32000）。
# ark 默认 4096 过小：thinking+脚本撞 length → run 被终止（轮次上限假象）
CODING_MAX_OUTPUT_TOKENS=32000

# Doom loop 护栏：连续 N 次完全相同调用触发拦截；run 内累计第 N 次命中熔断终止
# CODING_DOOM_LOOP_THRESHOLD=3
# CODING_DOOM_LOOP_MAX_HITS=5

# ── 插件开关 ─────────────────────────────────────────
ENABLE_SANDBOX=true
ENABLE_MCP=false

# ── Agent 目录（框架自动发现 BaseAgent 子类）─────────
AGENTS_ROOT=src/egis_opencode/agents

# ── Sandbox ──────────────────────────────────────────
# sandbox 配置文件位于 CONFIG_DIR/<agent_id>/sandbox.json
CONFIG_DIR=data/ark_config

# ── 会话 / 记忆 ──────────────────────────────────────
SESSIONS_DIR=data/ark_sessions
MEMORY_DIR=data/ark_memory

# ── 存储（会话/记忆等 ark 表）───────────────────────
# 缺省 SQLite（零配置）；切 PostgreSQL 取消注释并填连接串。
# 本地开发可复用 docker 里的现成 PG 库（如 weknora，与其他项目共库，
# 不新建容器/库）：先 open -a Docker → docker start <容器名>，
# ark 表自动迁移建表，与其他项目的表共存。
# DB_CONNECTION_STR=postgresql+asyncpg://user:password@localhost:5432/dbname

# ── Workspace（与 sandbox.json workspace.root 保持一致）─
CODING_WORKSPACE_ROOT=data/ark_workspaces
# 允许会话绑定本地任意目录（local:<path> 工作目录模式）；企业部署可置 false
CODING_ALLOW_LOCAL_WORKSPACE=true

# ── 默认工作目录（前端不传 workspace_root 时的服务端兑底）──
# 对齐 opencode「启动即工作目录」：本地/单人部署配 local + 绝对路径，
# 前端无需任何绑定操作开箱即用；multi（默认）= 多租户沙箱，行为不变
# CODING_DEFAULT_WORKSPACE_MODE=local
# CODING_DEFAULT_WORKSPACE_DIR=/absolute/path/to/your/project

# ── 权限 ─────────────────────────────────────────────
# ask 状态的权限请求等待用户应答的超时秒数；超时视为拒绝
CODING_PERMISSION_TIMEOUT=120
# 静默放行模式：ask 规则视同 allow 不弹审批卡片；deny 硬禁令
# （plan 只读、裸 pip 安装）不受影响仍拒。本地单人开发可置 true
CODING_PERMISSION_SILENT_ALLOW=false

# ── bash（本地目录模式直连执行）───────────────────
# CODING_BASH_TIMEOUT=120
# CODING_BASH_MAX_OUTPUT_BYTES=100000

# ── 工具输出统一截断（对齐 opencode tool_output）─────
# 行数/字节任一超限即截断：read 带续读提示；bash 全文落盘
# <工作区>/.truncation/ 并附 grep/read 续读指引。
# CODING_TOOL_OUTPUT_MAX_LINES=2000
# CODING_TOOL_OUTPUT_MAX_BYTES=51200
# CODING_TOOL_OUTPUT_MAX_LINE_LENGTH=2000

# ── Tracing（可选）───────────────────────────────────
# TRACING=phoenix
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces

# ── Skills（ark SkillLoader 加载模式）────────────────
# dynamic：仅注入元数据，模型经 read_skill 工具按需加载全文（默认，省 token）
# full   ：全部 skill 全文直接进 system prompt
# SKILL_LOAD_MODE=dynamic
